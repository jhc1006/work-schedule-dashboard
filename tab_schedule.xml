<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:ui="http://www.inswave.com/websquare/ui">
    <head>
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate>2026-09-04 06:46:00</w2:buildDate>
    </head>
    <body>
        <w2:group id="grp_tab_schedule" class="ws5_tab_content">
            <w2:gridView id="grd_sub_schedule" dataList="dlt_schedule" style="width:100%; height:450px;" autoFit="allColumn">
                <w2:header>
                    <w2:row>
                        <w2:column id="col_site" label="Site"></w2:column>
                        <w2:column id="col_fab" label="구역/Zone"></w2:column>
                        <w2:column id="col_type" label="작업유형"></w2:column>
                        <w2:column id="col_sub" label="작업구분"></w2:column>
                        <w2:column id="col_ut" label="작업대상"></w2:column>
                        <w2:column id="col_cnt" label="작업내용"></w2:column>
                        <w2:column id="col_img" label="작업 이미지"></w2:column>
                    </w2:row>
                </w2:header>
                <w2:gBody>
                    <w2:row>
                        <w2:column id="site" inputType="text"></w2:column>
                        <w2:column id="fab" inputType="text"></w2:column>
                        <w2:column id="type" inputType="text"></w2:column>
                        <w2:column id="subcat" inputType="select"></w2:column>
                        <w2:column id="utIds" inputType="select"></w2:column>
                        <w2:column id="content" inputType="text"></w2:column>
                        <w2:column id="imageUrl" inputType="image" imageWidth="48" imageHeight="48"></w2:column>
                    </w2:row>
                </w2:gBody>
            </w2:gridView>
        </w2:group>
    </body>
</html>
